
# Server
PORT=5000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=supabase_service_role_key

# Authentication
JWT_SECRET=a_long_random_secret

# Email (Resend)
RESEND_API_KEY=resend_api_key
EMAIL_FROM=AutoTrack Pro <noreply@example.com>

# SasuSync SMS Gateway
SASUSYNC_API_KEY=sasusync_api_key
SASUSYNC_BASE_URL=sasusync_api_base_url
SASUSYNC_SANDBOX=true
SASUSYNC_SENDER_ID=AUTOTRACK
SASUSYNC_WEBHOOK_SECRET=webhook_secret